{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.minorgroup\\.site" }],
      "destination": "https://minorgroup.site/:path*",
      "permanent": true
    }
  ]
}
